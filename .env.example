DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
# Development: register commands immediately in one guild. Omit for global registration.
DISCORD_DEV_GUILD_ID=replace-with-development-guild-id
# Use the same password in POSTGRES_DEV_PASSWORD and DATABASE_URL (URL-encode special characters).
POSTGRES_DEV_PASSWORD=<choose-a-unique-private-password>
DATABASE_URL=postgres://eiren:<url-encoded-private-password>@localhost:5432/eiren
LOG_LEVEL=info
# Set true only after enabling the privileged Server Members Intent in Discord's Developer Portal.
ENABLE_GUILD_MEMBERS_INTENT=false
# Dashboard is opt-in. Disabled bot startup never needs the settings below.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_BASE_URL=http://localhost:3000
# Generate privately with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
DASHBOARD_SESSION_SECRET=<replace-with-random-48-byte-secret>
DISCORD_CLIENT_SECRET=<replace-with-oauth-client-secret>
# Only enable behind a trusted reverse proxy; never trust forwarded headers by default.
DASHBOARD_TRUST_PROXY=false
