DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
# Development: register commands immediately in one guild. Omit for global registration.
DISCORD_DEV_GUILD_ID=replace-with-development-guild-id
# Use the same password in POSTGRES_DEV_PASSWORD and DATABASE_URL (URL-encode special characters).
POSTGRES_DEV_PASSWORD=replace-with-local-db-password
DATABASE_URL=postgres://eiren:replace-with-local-db-password@localhost:5432/eiren
LOG_LEVEL=info
